{
  "name": "iban-tr",
  "version": "1.0.2",
  "description": "Türk IBAN'larını doğrular, bankasını bulur, biçimler ve maskeler.",
  "keywords": [
    "iban",
    "iban doğrulama",
    "iban kontrol",
    "banka",
    "eft",
    "türkiye",
    "turkey",
    "iban validator"
  ],
  "homepage": "https://github.com/Kadirify/iban-tr#readme",
  "bugs": {
    "url": "https://github.com/Kadirify/iban-tr/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kadirify/iban-tr.git"
  },
  "license": "MIT",
  "author": "Kadir",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
